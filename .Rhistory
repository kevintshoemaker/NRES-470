mat0 = mat1; mat0[] = 0
dir = mat1 - mat0 #direction vector
dir = dir / sqrt(rowSums(dir^2)) #unit vector
fig = plotly_empty()
fig = fig |>
add_trace(
type = "scatter3d",
mode = "text",
x = thisdf$N1,
y = thisdf$N2,
z = thisdf$N3,
text = thisdf$label,
textposition = "top right",
showlegend = FALSE
)
